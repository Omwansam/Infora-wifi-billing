# Infora ISP billing — FreeRADIUS default virtual server (SQL auth + accounting)

server default {
    listen {
        type = auth
        ipaddr = *
        port = 0
        limit {
            max_connections = 16
            lifetime = 0
            idle_timeout = 30
        }
    }

    listen {
        type = acct
        ipaddr = *
        port = 0
        limit {
            max_connections = 16
            lifetime = 0
            idle_timeout = 30
        }
    }

    authorize {
        filter_username
        preprocess
        chap
        mschap
        digest
        # `suffix` is deliberately NOT enabled.
        #
        # It splits User-Name at "@" and sets Stripped-User-Name, and
        # mods-available/sql keys the lookup on
        #     %{%{Stripped-User-Name}:-%{User-Name}}
        # So with suffix in this chain, a subscriber whose login is an email —
        # which is what services/radius_provisioning.radius_username() falls back
        # to whenever an operator has not set an explicit radius_login — is
        # looked up as the local part alone, against a realm that is not in
        # proxy.conf. The request is not even rejected: it gets NO REPLY, so the
        # router just times out and the failure never reaches the app logs.
        # Verified on 2026-08-31: "probeuser" -> Access-Accept, but
        # "probe@example.com" -> no reply, with an identical radcheck row.
        # This deployment authenticates full usernames locally and never proxies
        # RADIUS, so there is nothing for realm handling to do here.
        eap {
            ok = return
        }
        sql
        expiration
        logintime
        pap
    }

    authenticate {
        Auth-Type PAP {
            pap
        }
        Auth-Type CHAP {
            chap
        }
        Auth-Type MS-CHAP {
            mschap
        }

        # The bare entries are NOT redundant — keep them.
        #
        # FreeRADIUS 3.2's rlm_mschap sets `Auth-Type` to its *module instance
        # name* (`mschap`), not to `MS-CHAP`. With only the `Auth-Type MS-CHAP`
        # block above, the server logs
        #     Found Auth-Type = mschap
        #     Auth-Type sub-section not found.  Ignoring.
        #     Failed to authenticate the user
        # and rejects. MikroTik PPPoE negotiates MS-CHAPv2 by default, so that
        # reject is what a CPE shows as "login failed" — while PAP-based hotspot
        # logins for the same subscriber still worked, which made it look like a
        # per-user problem rather than a config one.
        mschap
        digest
        eap
    }

    preacct {
        preprocess
        acct_unique
        # Not enabled, for the same reason as in authorize above: it would key
        # accounting on the stripped name while auth used the full one.
        files
    }

    accounting {
        detail
        sql
        attr_filter.accounting_response
    }

    session {
        sql
    }

    post-auth {
        update {
            &reply: += &session-state:
        }
        remove_reply_message_if_eap
        Post-Auth-Type REJECT {
            attr_filter.access_reject
            eap
            remove_reply_message_if_eap
        }
    }

    pre-proxy {
    }

    post-proxy {
        eap
    }
}
