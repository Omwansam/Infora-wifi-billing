# Infora ISP billing — FreeRADIUS default virtual server (SQL auth + accounting)

server default {
    listen {
        type = auth
        ipaddr = *
        port = 0
        limit {
            max_connections = 16
            lifetime = 0
            idle_timeout = 30
        }
    }

    listen {
        type = acct
        ipaddr = *
        port = 0
        limit {
            max_connections = 16
            lifetime = 0
            idle_timeout = 30
        }
    }

    authorize {
        filter_username
        preprocess
        chap
        mschap
        digest
        suffix
        eap {
            ok = return
        }
        sql
        expiration
        logintime
        pap
    }

    authenticate {
        Auth-Type PAP {
            pap
        }
        Auth-Type CHAP {
            chap
        }
        Auth-Type MS-CHAP {
            mschap
        }

        # The bare entries are NOT redundant — keep them.
        #
        # FreeRADIUS 3.2's rlm_mschap sets `Auth-Type` to its *module instance
        # name* (`mschap`), not to `MS-CHAP`. With only the `Auth-Type MS-CHAP`
        # block above, the server logs
        #     Found Auth-Type = mschap
        #     Auth-Type sub-section not found.  Ignoring.
        #     Failed to authenticate the user
        # and rejects. MikroTik PPPoE negotiates MS-CHAPv2 by default, so that
        # reject is what a CPE shows as "login failed" — while PAP-based hotspot
        # logins for the same subscriber still worked, which made it look like a
        # per-user problem rather than a config one.
        mschap
        digest
        eap
    }

    preacct {
        preprocess
        acct_unique
        suffix
        files
    }

    accounting {
        detail
        sql
        attr_filter.accounting_response
    }

    session {
        sql
    }

    post-auth {
        update {
            &reply: += &session-state:
        }
        remove_reply_message_if_eap
        Post-Auth-Type REJECT {
            attr_filter.access_reject
            eap
            remove_reply_message_if_eap
        }
    }

    pre-proxy {
    }

    post-proxy {
        eap
    }
}
