# =============================================================================
# Infora / Lumen billing — production .env
#
#   cd /srv/infora-billing
#   cp config/deployment/production.env.example .env
#   nano .env
#
# Full runbook: DEPLOYMENT.md (repo root)
#
# This file lists EVERY variable the code actually reads. Anything not set here
# falls back to the default shown in the comment. Two rules that have cost this
# deployment real downtime:
#
#   1. `docker-compose.prod.yml` now has `env_file: .env` on flask_app, so every
#      var below reaches the container. Before that, only the ~35 keys listed
#      explicitly under `environment:` did — the rest were silently ignored.
#   2. A change to this file needs `docker compose ... up -d flask_app`.
#      NOT `restart` and NOT `build` — neither re-reads the environment.
#      Verify with: docker inspect infora_flask --format '{{json .Config.Env}}'
#      Never verify by reading a value back out of the app: when the .env value
#      and the code default agree, a broken passthrough looks identical.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Identity of this box  (REQUIRED)
# -----------------------------------------------------------------------------
# The new server's public IPv4. MikroTik RADIUS and WireGuard must reach this
# address DIRECTLY — never through Cloudflare's HTTP proxy.
# CONTABO_PUBLIC_IP and APP_DOMAIN are not read by the app; they exist so the
# IP and domain are written down once, here, where you can find them.
CONTABO_PUBLIC_IP=YOUR_NEW_SERVER_IPV4
APP_DOMAIN=ruirufactorymabati.com


# -----------------------------------------------------------------------------
# 2. Secrets  (REQUIRED — generate fresh, do not reuse the old server's)
#    openssl rand -hex 32
# -----------------------------------------------------------------------------
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
JWT_SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
# Encrypts stored router/gateway credentials. Defaults to SECRET_KEY if unset.
# CHANGING THIS AFTER GO-LIVE MAKES EVERY STORED CREDENTIAL UNREADABLE.
ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32
# Shared secret for the FreeRADIUS <-> NAS handshake. Per-ISP secrets in the DB
# override this; it is the fallback and the value baked into clients.conf.
RADIUS_SECRET=CHANGE_ME_openssl_rand_hex_32
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_24

# Must embed the SAME password as POSTGRES_PASSWORD above, or Flask cannot log
# in to its own database. Host is the compose service name, not localhost.
DATABASE_URL=postgresql://infora_user:CHANGE_ME_openssl_rand_hex_24@postgres:5432/infora_billing
FLASK_ENV=production


# -----------------------------------------------------------------------------
# 3. Public URLs  (REQUIRED)
#
# Domain layout as deployed:
#   apex + www   -> Lumen marketing website
#   billing.     -> billing admin console + captive portal + API
#   demo.        -> interactive demo (API simulated in the browser)
#   lumen.       -> 301 redirect to the apex (legacy)
#   webfig.      -> one-click router WebFig proxy
# -----------------------------------------------------------------------------
# Browser origins allowed to call the API. Comma-separated, no trailing slash.
# A login that works on localhost but fails on the domain is almost always this.
CORS_ORIGINS=https://ruirufactorymabati.com,https://www.ruirufactorymabati.com,https://billing.ruirufactorymabati.com

# Captive-portal SPA origin. If this is wrong or unset, hotspot users get a
# BLANK login page — the portal redirect sends phones somewhere unreachable.
# After changing it, re-run "Configure services" on every hotspot router so the
# walled garden and login.html are rewritten with the new host.
PORTAL_BASE_URL=https://billing.ruirufactorymabati.com

# Browser-reachable base URL of this backend. Used to build absolute URLs for
# API-served assets (e.g. the ISP logo on the captive portal).
PUBLIC_BASE_URL=https://billing.ruirufactorymabati.com

# HTTPS base URL a router uses to self-fetch its provisioning script.
# MUST be a domain with a valid TLS cert — a bare IP fails RouterOS's
# /tool fetch certificate check and one-line provisioning dies silently.
PROVISION_BASE_URL=https://ruirufactorymabati.com

# Password-reset link base. Falls back to PUBLIC_BASE_URL, then
# PROVISION_BASE_URL. Set it when reset mails should point at the console.
APP_BASE_URL=https://billing.ruirufactorymabati.com

# Domain the WebFig one-click proxy hangs off — the app opens webfig.<domain>.
# Must be a name the TLS cert covers. Cloudflare Universal SSL covers
# *.ruirufactorymabati.com, so `webfig.ruirufactorymabati.com` works but
# `webfig.billing.ruirufactorymabati.com` (second level) does NOT.
# Needs a PROXIED Cloudflare A record. Unset => derived from the request,
# which yields the uncovered sub-sub-domain and a TLS error.
WEBFIG_PROXY_DOMAIN=ruirufactorymabati.com

# Base domain for per-tenant hostnames shown in Settings > Domain.
# Unset => derived from the request host.
TENANT_BASE_DOMAIN=ruirufactorymabati.com


# -----------------------------------------------------------------------------
# 4. Frontend build args  (REQUIRED — read at BUILD time, not run time)
#
# These are baked into the JS bundle by `docker compose build web`.
# Changing them means rebuilding the web image; a restart does nothing.
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=https://billing.ruirufactorymabati.com
VITE_RADIUS_SERVER=YOUR_NEW_SERVER_IPV4
VITE_FREERADIUS_HOST=YOUR_NEW_SERVER_IPV4

LUMEN_SITE_URL=https://ruirufactorymabati.com
LUMEN_APP_URL=https://billing.ruirufactorymabati.com
LUMEN_DEMO_URL=https://demo.ruirufactorymabati.com


# -----------------------------------------------------------------------------
# 5. RADIUS  (REQUIRED)
# -----------------------------------------------------------------------------
# Public host MikroTik points its RADIUS client at. IP or a DNS-ONLY (grey
# cloud) name — an orange-cloud name cannot carry UDP.
FREERADIUS_HOST=YOUR_NEW_SERVER_IPV4
PUBLIC_SERVER_HOST=YOUR_NEW_SERVER_IPV4

# Where `flask generate-radius-clients` writes the NAS list. This path is a bind
# mount shared with the freeradius container — leave it alone.
RADIUS_CLIENTS_CONF_PATH=/config/freeradius/clients.conf

# Interim accounting update interval pushed to routers. Default: 5m
# RADIUS_INTERIM_UPDATE=5m
# A session with no accounting update for this many minutes is treated as dead.
# Default: 15
# RADIUS_SESSION_STALE_MINUTES=15
# Used only by the router-scan verifier when test-authing against a NAS.
# Default: FREERADIUS_HOST / RADIUS_SECRET / 1812
# RADIUS_VERIFY_HOST=
# RADIUS_VERIFY_SECRET=
# RADIUS_AUTH_PORT=1812


# -----------------------------------------------------------------------------
# 6. WireGuard  (REQUIRED)
#   UDP 51820 = customer VPN     UDP 51821 = MikroTik management tunnel
# -----------------------------------------------------------------------------
# Endpoint written into router configs. Use a DNS-ONLY (grey cloud) name or the
# raw IP. Orange-cloud here = tunnels that never handshake.
WIREGUARD_MGMT_ENDPOINT=wg.ruirufactorymabati.com
WIREGUARD_MGMT_PORT=51821
WIREGUARD_CONFIG_DIR=/app/wireguard_configs
WIREGUARD_MIKROTIK_AUTO_PUSH=true

# Management tunnel addressing. Routers reach RADIUS at WIREGUARD_MGMT_SERVER_IP
# over the tunnel. Only change these on a fresh deployment — existing peers hold
# addresses from this range.
WIREGUARD_MGMT_SUBNET=10.250.0.0/24
WIREGUARD_MGMT_SERVER_IP=10.250.0.1


# -----------------------------------------------------------------------------
# 7. Device monitoring
#
# DEVICE_POLL_INTERVAL is what makes the resource graphs continuous and lets an
# overnight outage be recorded at all. With it at 0 nothing syncs on a schedule
# and the trend only moves when someone opens a device page.
# -----------------------------------------------------------------------------
DEVICE_POLL_INTERVAL=300            # seconds; 0 disables the poller
DEVICE_SAMPLE_MIN_INTERVAL=60       # floor between two stored samples
DEVICE_SAMPLE_RETENTION_DAYS=30     # ~8.6k rows/router/month at a 5-min poll

# Hysteresis before a router is flipped OFFLINE. A router keepalives every 25s
# and netwatch-pings every 60s, so one failed probe is not an outage. Lowering
# these is what made the cards flap Offline/Online.
DEVICE_OFFLINE_GRACE_SECONDS=300
DEVICE_RADIUS_EVIDENCE_SECONDS=900
DEVICE_PROVISION_EVIDENCE_SECONDS=600

# Router config backups. The default is INSIDE the container and is lost on
# every rebuild — point it at a mounted path if you want backups to survive.
# DEVICE_BACKUP_DIR=/app/uploads/device_backups

ROUTER_TIMEZONE=Africa/Nairobi


# -----------------------------------------------------------------------------
# 8. Schedulers  (0 = OFF, which is the default and the current live state)
#
# These are in-process background threads. Left at 0, expired subscribers are
# never disconnected and FUP throttles are never applied — the buttons in the
# console still work, but nothing happens on its own overnight.
# The alternative is cron on the host calling:
#   docker compose ... exec -T flask_app flask enforce-expiry
#   docker compose ... exec -T flask_app flask enforce-fup
# -----------------------------------------------------------------------------
SUBSCRIPTION_ENFORCEMENT_INTERVAL=0   # seconds between expiry sweeps
SUBSCRIPTION_GRACE_HOURS=0            # hours past expiry before disconnect
FUP_ENFORCEMENT_INTERVAL=0            # seconds between FUP sweeps


# -----------------------------------------------------------------------------
# 9. Platform subscription — what a tenant ISP pays YOU
#    Console locks when subscription_expires_at + grace passes.
#    The customer-facing network is never cut by this. See SUBSCRIPTION.md.
# -----------------------------------------------------------------------------
PLATFORM_VENDOR_NAME=Lumen
PLATFORM_TRIAL_DAYS=14
PLATFORM_BILLING_PERIOD_DAYS=30
PLATFORM_GRACE_DAYS=0                 # 0 = lock the moment it expires
PLATFORM_ISSUE_LEAD_DAYS=7            # how early the next invoice is raised


# -----------------------------------------------------------------------------
# 10. TR-069 / CWMP ACS  (customer CPE / ONT fleet — see TR069.md)
#
# The ACS URL must be reachable from the SUBSCRIBER network and served
# DNS-ONLY (grey cloud): a CDN/WAF in front of CWMP mangles the SOAP POSTs, and
# budget ONTs fail on modern TLS chains.
#
# NOT WIRED IN PRODUCTION YET: docker-compose.prod.yml publishes only 5080, and
# nginx proxies only /api/ — so /tr069 currently has no route in. To enable,
# see DEPLOYMENT.md "Optional: TR-069". Leave TR069_ACS_URL empty until then.
# -----------------------------------------------------------------------------
TR069_ACS_URL=
# Keep FALSE in production — the ACS faces the whole internet, so only
# pre-enrolled devices may register. true is an onboarding-only convenience.
TR069_ALLOW_UNKNOWN=false
TR069_PERIODIC_INFORM_INTERVAL=300
TR069_SESSION_RETENTION_DAYS=7


# -----------------------------------------------------------------------------
# 11. M-Pesa / Daraja
#
# Per-ISP credentials saved in Settings > Payments OVERRIDE everything here.
# Prefer setting them there; these are the platform-wide fallback.
# Do not set MPESA_ENVIRONMENT=production while holding sandbox test keys
# (shortcode 174379 is Safaricom's sandbox till) — that combination is inert
# and looks like a broken gateway.
# -----------------------------------------------------------------------------
MPESA_ENVIRONMENT=sandbox
# Must be HTTPS and publicly reachable, on a vhost that proxies /api/.
MPESA_CALLBACK_URL=https://ruirufactorymabati.com/api/payments/mpesa/callback
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# CustomerPayBillOnline (paybill) or CustomerBuyGoodsOnline (till)
# MPESA_TRANSACTION_TYPE=CustomerPayBillOnline


# -----------------------------------------------------------------------------
# 12. Outbound email (SMTP)
#
# A tenant's own SMTP row (Settings > Email) wins over these. Resolution is
# ALL-OR-NOTHING per source: a half-filled tenant row falls back whole, so the
# two are never blended (which would pair a tenant host with a platform
# password and look like a wrong password).
# With none of this set, every mail silently becomes a log line.
# -----------------------------------------------------------------------------
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USE_SSL=false
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER=billing@ruirufactorymabati.com


# -----------------------------------------------------------------------------
# 13. SMS  (hotspot credentials, expiry alerts, payment details)
#
# Same tenant-first rule as SMTP. SMS_ENABLED=false => every send is logged,
# not sent. Confirm a message was composed with:
#   docker logs infora_flask | grep "SMS \["
# Africa's Talking is called over plain HTTP — the SDK is NOT installed and must
# not be reintroduced.
# -----------------------------------------------------------------------------
SMS_ENABLED=false
SMS_PROVIDER=log                      # log | africastalking | twilio
# AT_USERNAME=
# AT_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=


# -----------------------------------------------------------------------------
# 14. WhatsApp  (tenant-only by design — a shared number cannot carry another
#     business's branding, so there is no platform fallback for it)
# -----------------------------------------------------------------------------
WHATSAPP_ENABLED=false
# WHATSAPP_PROVIDER=meta              # meta | twilio
# WHATSAPP_META_TOKEN=
# WHATSAPP_META_PHONE_NUMBER_ID=
# WHATSAPP_META_TEMPLATE=
# WHATSAPP_META_TEMPLATE_LANG=en
# WHATSAPP_META_TEMPLATE_HAS_BUTTON=false
# WHATSAPP_META_API_VERSION=v21.0
# TWILIO_WHATSAPP_FROM=


# -----------------------------------------------------------------------------
# 15. Misc
# -----------------------------------------------------------------------------
# Uploaded ISP logos. docker-compose.prod.yml HARD-CODES this to /app/uploads/logos
# (the isp_uploads volume) and that wins over whatever you put here — which is
# correct: any other path is lost on rebuild and the portal logo 404s.
LOGO_UPLOAD_DIR=/app/uploads/logos

# Reject signup emails whose domain has no MX record. Needs a working resolver
# in the container; leave false unless you have verified DNS works there.
SIGNUP_EMAIL_MX_CHECK=false

# Optional AI assistant in the console. Unset = the feature is simply off.
# ANTHROPIC_API_KEY=
